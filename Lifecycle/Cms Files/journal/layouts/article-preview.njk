              <div>
                  {% if article.parsedSubmission.associated %}
                    {% set relatedManuscripts = article.parsedSubmission.associated.split(', ') %}
                  
                    <div class="button-common" id="versions-btn" tabindex="0">
                      Versions
                      <div class="popover versions_btn">
                        <ul class="version-list">
                          {% for shortId in relatedManuscripts | reverse %}
                            {% set isCurrent = (shortId | int) == (article.shortId | int) %}
                            <li class="{% if isCurrent %}current{% endif %}">
                              <a href="/articles/{{ shortId }}/index.html">
                                Version {{ loop.length - loop.index0 }}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  {% endif %}
                  {% if article.files and article.files.length > 0 %}
                    {% set pdfFiles = [] %}
                    {% for file in article.files %}
                      {% if file.name and file.name.includes('.pdf') %}
                        {% set pdfFiles = (pdfFiles.push(file), pdfFiles) %}
                      {% endif %}
                    {% endfor %}
                    
                    {% if pdfFiles.length > 0 %}
                      {% set lastPdf = pdfFiles[pdfFiles.length - 1] %}
                      {% if lastPdf and lastPdf.storedObjects and lastPdf.storedObjects[0] %}
                        <button class="button-common" id="download-pdf">
                          {% set linkUrl = lastPdf.storedObjects[0].url %}
                          {% set linkText = 'Download' %}
                         {{ ('<a href="' + linkUrl + '" download="' + article.parsedSubmission.$title + '.pdf" target="_blank">' + linkText + '</a>') | linkHandler(article.shortId, 'supplementary-files', cmsConfig.group, cmsLayout.hexCode) | safe }}

                        </button>
                      {% endif %}
                    {% endif %}
                  {% endif %}       
                 

              data: '<svg version="1.2" preserveAspectRatio="none" style="overflow: visible; opacity: 1; mix-blend-mode: normal; width: 19px; height: 22px;"><g transform="translate(0, 0) rotate(0)"><path style="stroke-width: 0; stroke-linecap: butt; stroke-linejoin: miter; fill: var(--color-skyblue);" d="M13.60052,4.78722v17.21278h5.39948v-17.21278zM6.79751,22h5.40498v-22h-5.40498zM0,22h5.40498v-8.22977h-5.40498z"></path></g><defs><path id="path-1739565650491233" d="M13.60052,4.78722v17.21278h5.39948v-17.21278zM6.79751,22h5.40498v-22h-5.40498zM0,22h5.40498v-8.22977h-5.40498z"></path></defs></svg>',
              code: '<svg version="1.2" preserveAspectRatio="none" class="ng-element" data-id="4165d51d892644f09982a9c0e74a1343" style="overflow: visible; opacity: 1; mix-blend-mode: normal; width: 24px; height: 19px; ;"><g transform="translate(-1.0130785099704553e-15, -0.0000016703287746139273) rotate(0)"><path style="stroke-width: 0; stroke-linecap: butt; stroke-linejoin: miter; fill: var(--color-skyblue);" d="M10.4592,18.9812l-2.2896,-0.65574c-0.24,-0.06652 -0.3744,-0.31361 -0.3072,-0.5512l5.1216,-17.45305c0.0672,-0.23759 0.3168,-0.37063 0.5568,-0.30411l2.2896,0.65574c0.24,0.06652 0.3744,0.31361 0.3072,0.5512l-5.1168,17.45305c-0.072,0.23759 -0.3168,0.37539 -0.5568,0.30411zM6.1824,14.81869l1.632,-1.72012c0.1728,-0.18057 0.1632,-0.47042 -0.0288,-0.63673l-3.3984,-2.96032l3.3984,-2.96032c0.192,-0.16631 0.2064,-0.45616 0.0288,-0.63673l-1.632,-1.72012c-0.168,-0.17581 -0.456,-0.19007 -0.6384,-0.01901l-5.4,5.00831c-0.192,0.17581 -0.192,0.47517 0,0.65098l5.4048,5.01306c0.1824,0.17106 0.4704,0.16156 0.6384,-0.01901v0zM18.4512,14.84245l5.4048,-5.01306c0.192,-0.17581 0.192,-0.47517 0,-0.65098l-5.4048,-5.01781c-0.1776,-0.16631 -0.4656,-0.16156 -0.6384,0.01901l-1.632,1.72012c-0.1728,0.18057 -0.1632,0.47042 0.0288,0.63673l3.3984,2.96032l-3.3984,2.96032c-0.192,0.16631 -0.2064,0.45616 -0.0288,0.63673l1.632,1.72012c0.168,0.18057 0.456,0.19007 0.6384,0.02376v0z"></path></g><defs><path id="path-1739565650483228" d="M10.4592,18.9812l-2.2896,-0.65574c-0.24,-0.06652 -0.3744,-0.31361 -0.3072,-0.5512l5.1216,-17.45305c0.0672,-0.23759 0.3168,-0.37063 0.5568,-0.30411l2.2896,0.65574c0.24,0.06652 0.3744,0.31361 0.3072,0.5512l-5.1168,17.45305c-0.072,0.23759 -0.3168,0.37539 -0.5568,0.30411zM6.1824,14.81869l1.632,-1.72012c0.1728,-0.18057 0.1632,-0.47042 -0.0288,-0.63673l-3.3984,-2.96032l3.3984,-2.96032c0.192,-0.16631 0.2064,-0.45616 0.0288,-0.63673l-1.632,-1.72012c-0.168,-0.17581 -0.456,-0.19007 -0.6384,-0.01901l-5.4,5.00831c-0.192,0.17581 -0.192,0.47517 0,0.65098l5.4048,5.01306c0.1824,0.17106 0.4704,0.16156 0.6384,-0.01901v0zM18.4512,14.84245l5.4048,-5.01306c0.192,-0.17581 0.192,-0.47517 0,-0.65098l-5.4048,-5.01781c-0.1776,-0.16631 -0.4656,-0.16156 -0.6384,0.01901l-1.632,1.72012c-0.1728,0.18057 -0.1632,0.47042 0.0288,0.63673l3.3984,2.96032l-3.3984,2.96032c-0.192,0.16631 -0.2064,0.45616 -0.0288,0.63673l1.632,1.72012c0.168,0.18057 0.456,0.19007 0.6384,0.02376v0z"></path></defs></svg>',
            }

            const COLUMNS = ['Service', 'Summary', 'Version', 'Date', 'Evaluated']
            const ROWS = evaluations

            const TDATA = evaluationData => {
              const [name = '', url, summary, version, date, ...iconsFromData] = evaluationData?.url.split(',') ?? []
              const imgUrl = name.includes('.') && `${WP_URL_PREFIX}${name}`
              const alt = toReadableString(name)

              const serviceRender = imgUrl ? `<img src="${imgUrl}" alt="${alt}" />` : `<span class="service-name">${name}</span>`
              const iconsRender = render(values(ICONS), (icon, i) => iconsFromData[i] === '1' ? `<a href='#' class="button-common icon">${icon}</a>` : '')
        
              const tableData = {
                service: `<a href="${url}" target="_blank">${serviceRender}</a>`,
                summary: summary || '?',
                version: version || '?',
                date: date || '?',
                evaluated: `<div class='flex-row'>${iconsRender}</div>`,
              }

              return values(tableData)
            }

            const rowRender = ev => render(TDATA(ev), td => `<td>${td}</td>`)
            const columnsRender = render(COLUMNS, col => `<th>${col}</th>`)                 
            const rowsRender = render(ROWS, evaluation => `<tr>${rowRender(evaluation)}</tr>`)
  
            return `
              <div class="table-wrapper">
                <table class="evaluations-table">
                  <thead><tr>${columnsRender}</tr></thead>
                  <tbody>${rowsRender}</tbody>
                </table>
              </div>
            `
          }         
                             
        
          const declarationsContent = () => {
            const declarationsSections = ['ethics','competingInterests', 'Funding', 'authorContributions']
        
            return render(declarationsSections, s => {
              const value = find(s)
              if (!value) return ''
              const val = value
              return `<h4>${camelCaseToHumanReadable(s)}</h4>${val}`
            })
          }
          // #endregion Content

                const notesContent = () => {
  const n = notes
  if (!n) return null
  return `<p>${n}</p>`
}
          // #region Sections
          const sections = {
            abstract,
            evaluations: evaluationsContent(),
            registration,
            materials,
            data,
            code,
            paper,
              notes: notesContent(),  
            declarations: declarationsContent(),
          }
        
          const createSection = ([key, content]) => {
            if (!content) return
            const tocWrapper = $('.toc ol')
            const manuscript = $('.manuscript')
        
            const li = document.createElement('li')
            const a = document.createElement('a')
            a.href = `#meta-${key}`
            a.textContent = key
            li.appendChild(a)
            tocWrapper.appendChild(li)
        
            const section = document.createElement('section')
            section.id = `meta-${key}`
            section.classList.add('meta-section')
            section.innerHTML = `<h3 id="${key}" class="meta-section-title">${key}</h3>${content}`
            manuscript.appendChild(section)
          }
        
          entries(sections).forEach(createSection)
          // #endregion Sections
        
          window.addEventListener('scroll', () => {
            const scrollPosition = window.scrollY
            const tocLinks = document.querySelectorAll('.toc ol li a')
        
            tocLinks.forEach(link => {
              const target = $(link.hash)
        
              if (target) {
                const { top } = target.getBoundingClientRect()
                const targetTop = top + scrollPosition - 150
                const targetBottom = targetTop + target.offsetHeight
                const isInView = targetTop <= scrollPosition && targetBottom > scrollPosition
        
                if (isInView) {
                  tocLinks.forEach(l => l.closest('li').classList.remove('active'))
                  link.closest('li').classList.add('active')
                }
              }
            })
          })

          const copyToClipboardBtn = $('#copy-to-clipboard')
          copyToClipboardBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(`{{ article.parsedSubmission.cite | safe }}`)
            document.activeElement.blur()
          })


        })
    </script>

    <main>
        <div class="article-preview-header">
            <span class="topics">
                {{ article.headerInfo.topics }}
            </span>
            <span class="article-title">
                {{ article.headerInfo.title }}
            </span>
            <ul id="authors-contributors" class="flex-row" style="margin: 0;"></ul>


            {% if rorArray.length > 0 %}
              <ol id="affiliations-list" style="margin-left: 20px;">
                {% for re in rorArray %}
                  <li style="margin-left: 0px;">{{ re | safe }}</li>
                {% endfor %}
              </ol>
            {% endif %}

            {% if article.parsedSubmission.datePublished %}
                <p >
                    Published on {{ article.parsedSubmission.datePublished | safe }}
                </p>
            {% endif %}

          <!-- This is what I have added -->
          <div class="version-and-status">
              Version {{ article.articleMetadata.submission.version }} | Status: {{ article.parsedSubmission.status }}
          </div>

          {% if article.parsedSubmission.dateStatus %}
            <div class="status-date">
              Status Date: {{ article.parsedSubmission.dateStatus | safe }}
            </div>
          {% endif %}

          <div id="submission-type" data-raw="{{ article.articleMetadata.submission.type }}"></div>

          <script>
            const raw = document.getElementById('submission-type').dataset.raw;
            const withSpaces = raw.replace(/([a-z])([A-Z])/g, '$1 $2');
            document.getElementById('submission-type').textContent = withSpaces;
          </script>

          <span class="header-doi-and-licenses">
            <p class="doi"> DOI: 
            <a href="https://doi.org/{{ article.headerInfo.DOI }}">
              {{ article.headerInfo.DOI }}
            </a>
            {% if cmsLayout.publishConfig.licenseUrl %}
               <a href="{{cmsLayout.publishConfig.licenseUrl}}">
                  {{cmsLayout.publishConfig.licenseUrl}}
               </a>
            </p>
            {% endif %}
           </span>

          <div class="header-bottom">
              <div>

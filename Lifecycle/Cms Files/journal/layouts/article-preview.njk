{% set currentPage = article %}
{% extends '../layouts/base.njk' %}
{% set title = article.meta.title %}
{% block content %}

{% set rorArray = [] %}
{% if article.parsedSubmission.contributors %}
  {% set people = article.parsedSubmission.contributors %}
{% elif article.parsedSubmission.$authors %}
  {% set people = article.parsedSubmission.$authors %}
{% else %}
  {% set people = [] %}
{% endif %}

{% for contributor in people %}
  {% set rors = contributor.ror %}
  {% if rors is not iterable %}
    {% set rors = [rors] %}
  {% endif %}
  {% for ror in rors %}
    {% if ror and ror.label and not (ror.label in rorArray) %}
      {% set rorArray = (rorArray.push(ror.label), rorArray) %}
    {% endif %}
  {% endfor %}
{% endfor %}

<script>
  const rorArray = {{ rorArray | dump | safe }};
</script>
    <script>
        window.addEventListener('load', () => {
          const { keys, values, entries } = Object
          const $ = sel => document.querySelector(sel)
          const render = (arr, cb) => (arr || []).map(cb).join('')
          const camelCaseToHumanReadable = str => {
              const result = str.replace(/([A-Z])/g, ' $1').toLowerCase();
              return result.replace(/\b\w/g, char => char.toUpperCase());
          }
          const toReadableString = (str) => {
              if (!str) return '';
              
              return str
                .replace(/[-_.]/g, ' ')
                .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
                .replace(/([A-Z])([A-Z][a-z])/g, '$1 $2')
                .replace(/\s+/g, ' ')
                .trim()
                .split(' ')
                .map(word => word ? word.charAt(0).toUpperCase() + word.slice(1).toLowerCase() : '')
                .join(' ');
          }
        
          // #region articleMeta
          const submission = {{ article.parsedSubmission | dump | safe }}
          const find = field => submission[field] ?? null

          const abstract = find('$abstract')
          const evaluations = find('evaluations')
          const registration = find('registration')
          const notes = find('notes')
          const materials = find('materials')
          const data = find('data')
          const code = find('code')
          const contributors = find('contributors') || find('$authors')
          
          const authorContributions = `{{ article.articleMetadata.submission.authorContributions | safe }}`
          // #endregion articleMeta

          // #region Contributors
          const container = $()
          const renderAuthors = () => {
          const authorsLi = render(contributors, (contributor, i) => { 
              const { email = '', firstName = '', lastName = '', middleName = '', orcid = '', ror = null } = contributor;
              const rors = Array.isArray(ror) ? ror : ror ? [ror] : [];
              const superscripts = rors.map(r => {
                const index = rorArray.indexOf(r?.label);
                return index !== -1 ? `<sup>${index + 1}</sup>` : '';
              }).join('');

              const { value: rorUrl, label: rorName } = ror || {}
              const mailIcon = '<svg version="1.2" preserveAspectRatio="none" viewBox="0 0 512 512" stroke-linecap="null" stroke-linejoin="null" width="20px" height="20px"><path d="M64 112c-8.8 0-16 7.2-16 16v22.1L220.5 291.7c20.7 17 50.4 17 71.1 0L464 150.1V128c0-8.8-7.2-16-16-16H64zM48 212.2V384c0 8.8 7.2 16 16 16H448c8.8 0 16-7.2 16-16V212.2L322 328.8c-38.4 31.5-93.7 31.5-132 0L48 212.2zM0 128C0 92.7 28.7 64 64 64H448c35.3 0 64 28.7 64 64V384c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V128z" style="fill: rgb(68, 157, 209);"></path></svg>'
              const orcidIcon = '<img class="ng-element el-image" data-id="f1206412226d4b6e99b8246aaa823d51" style="padding: 0; opacity: 1; mix-blend-mode: normal; border-radius: 0px; object-fit: cover; object-position: center center; width: 20px; height: 20px;" src="https://uc.uxpin.com/files/89985/97294/ORCID_iD_icon_24x24-a6079546e2c9f3768c818aa206d3f8f1-2c1629.png">'
              const emailLink = email ? `<a style="display: flex;" href="mailto:${email}">${mailIcon}</a>` : ''
              const orcidLink = orcid ? `<a title="${orcid}" href="https://orcid.org/${orcid}">${orcidIcon}</a>` : ''
              const comma = i !== contributors?.length - 1 ? ',' : ''
              return`
              <li style="margin-left: 0;" class="flex-row">
                <span style="display: flex; align-items: center; gap: 1ch; margin: 0">
                    ${firstName}
                    ${middleName}
                    ${lastName}
                    ${superscripts}
                </span>
                  ${emailLink}
                  ${orcidLink}
                  ${comma}
     
              </li>`
            })

            return `${authorsLi}`
          }

          $('#authors-contributors').innerHTML = renderAuthors()
        
          // #region Content
          const paper = `{{ article.meta.source | imagesHandler(article.shortId, 'articles', cmsConfig.group, cmsLayout.hexCode) | makeSvgsFromLatex(true) | safe }}`
        
          const evaluationsContent = () => {
            if (!evaluations) return null
            const WP_URL_PREFIX = 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/'
            const ICONS = {
              paper: '<svg version="1.2" preserveAspectRatio="none" class="ng-element" data-id="6e6fcd8020404bd38e89f394af88db10" style="overflow: visible; opacity: 1; mix-blend-mode: normal; width: 16px; height: 22px;"><g transform="translate(8.881784197001252e-16, 0) rotate(0)"><path style="stroke-width: 0; stroke-linecap: butt; stroke-linejoin: miter; fill: var(--color-skyblue);" d="M10.66477,0v5.50146h5.33523zM9.33523,5.50146v-5.50146h-7.33523c-1.10227,0 -2,0.9257 -2,2.06232v17.87537c0,1.13662 0.89773,2.06232 2,2.06232h12c1.10227,0 2,-0.9257 2,-2.06232v-13.05939h-5.29545c-0.77273,0 -1.36932,-0.61518 -1.36932,-1.37683zM11.33523,17.87537h-6.66477c-0.36932,0 -0.66477,-0.31052 -0.66477,-0.68549c0,-0.37497 0.30114,-0.68549 0.66477,-0.68549h6.66477c0.36932,0 0.66477,0.31052 0.66477,0.68549c0,0.37497 -0.30114,0.68549 -0.66477,0.68549zM11.33523,15.12756h-6.66477c-0.36932,0 -0.66477,-0.31052 -0.66477,-0.68549c0,-0.37497 0.30114,-0.68549 0.66477,-0.68549h6.66477c0.36932,0 0.66477,0.31052 0.66477,0.68549c0,0.37497 -0.30114,0.68549 -0.66477,0.68549zM12,11.68842c0,0.38083 -0.30114,0.68549 -0.66477,0.68549h-6.66477c-0.36932,0 -0.66477,-0.31052 -0.66477,-0.68549c0,-0.37497 0.30114,-0.68549 0.66477,-0.68549h6.66477c0.36932,0 0.66477,0.31052 0.66477,0.68549z"></path></g><defs><path id="path-1739565650498244" d="M10.66477,0v5.50146h5.33523zM9.33523,5.50146v-5.50146h-7.33523c-1.10227,0 -2,0.9257 -2,2.06232v17.87537c0,1.13662 0.89773,2.06232 2,2.06232h12c1.10227,0 2,-0.9257 2,-2.06232v-13.05939h-5.29545c-0.77273,0 -1.36932,-0.61518 -1.36932,-1.37683zM11.33523,17.87537h-6.66477c-0.36932,0 -0.66477,-0.31052 -0.66477,-0.68549c0,-0.37497 0.30114,-0.68549 0.66477,-0.68549h6.66477c0.36932,0 0.66477,0.31052 0.66477,0.68549c0,0.37497 -0.30114,0.68549 -0.66477,0.68549zM11.33523,15.12756h-6.66477c-0.36932,0 -0.66477,-0.31052 -0.66477,-0.68549c0,-0.37497 0.30114,-0.68549 0.66477,-0.68549h6.66477c0.36932,0 0.66477,0.31052 0.66477,0.68549c0,0.37497 -0.30114,0.68549 -0.66477,0.68549zM12,11.68842c0,0.38083 -0.30114,0.68549 -0.66477,0.68549h-6.66477c-0.36932,0 -0.66477,-0.31052 -0.66477,-0.68549c0,-0.37497 0.30114,-0.68549 0.66477,-0.68549h6.66477c0.36932,0 0.66477,0.31052 0.66477,0.68549z"></path></defs></svg>',
              reg: '<svg version="1.2" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" class="ng-element" data-id="7cc2619f8c58485b8a6eb3e147080999" style="overflow: visible; width: 24px; height: 19px; opacity: 1; mix-blend-mode: normal;"><defs><path id="path-1739565650495238" d="M1.8570140634704537 13.341609708467017 C1.2595399734843071 12.753243130143684 1.3887235605083388 11.666620170177152 1.8570140634704537 11.200167387362258 C1.8570140634704537 11.200167387362258 1.8570140634704537 11.200167387362258 1.8570140634704537 11.200167387362258 C1.8570140634704537 11.200167387362258 3.514870096945526 9.56758264751012 3.514870096945526 9.56758264751012 C4.112344186931672 8.979216069186782 5.091986388530578 8.979216069186782 5.6894604785167235 9.56758264751012 C5.6894604785167235 9.56758264751012 8.273132218997356 12.111870553773198 8.273132218997356 12.111870553773198 C8.870606308983497 12.70023713209653 9.85024851058241 12.70023713209653 10.447722600568548 12.111870553773198 C10.447722600568548 12.111870553773198 21.175342973022513 1.5371739433672764 21.175342973022513 1.5371739433672764 C21.772817063008645 0.9488073650439391 22.752459264607555 0.9488073650439391 23.349933354593702 1.5371739433672764 C23.349933354593702 1.5371739433672764 25.007789388068772 3.1697586832194173 25.007789388068772 3.1697586832194173 C25.605263478054926 3.7581252615427565 25.605263478054926 4.722834426000838 25.007789388068772 5.311201004324178 C25.007789388068772 5.311201004324178 10.442339951109219 19.654624075882275 10.442339951109219 19.654624075882275 C9.844865861123077 20.24299065420562 8.865223659524165 20.24299065420562 8.267749569538022 19.654624075882275 C8.267749569538022 19.654624075882275 1.8570140634704537 13.341609708467017 1.8570140634704537 13.341609708467017 Z"></path></defs><g transform="translate(-1.455894955558383, -1.0958990096247736)"><path style="stroke-width: 0; stroke-linecap: butt; stroke-linejoin: miter;
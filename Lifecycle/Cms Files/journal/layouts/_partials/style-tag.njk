<style>
#authors-contributors {
  display: inline;
  flex-wrap: wrap;
  gap: 1ch;
  padding: 0;
  list-style: none;
  margin: 0;
}

#authors-contributors li {
  display: inline-flex;
  align-items: center;
  gap: 0.5ch;
  flex-wrap: nowrap;
}

#authors-contributors li span {
  display: inline;
}

  body {
    --header-height: 93px;
    --pad-x-g: 10%;
    --toc-display: flex;

    margin: 0;
    overflow-x: hidden;
    width: 100vw;
  }

  input#menu-btn, label.menu-icon {
      display: none;
  }

  header.topbar {
    margin: 0;
    padding: 8px var(--pad-x-g) !important;
    display: flex;
    height: var(--header-height);
    align-items: center;
    flex-direction: row;
    justify-content: space-between;
    font-family: var(--font-interface);
    top: 0;
    position: sticky !important;
    z-index: 99 !important;

    a.logo {
      padding-inline: 0;
      
      img {
        width: 100%;
        height: 63px;
        object-fit: contain;
        max-width: 157px;
      }
    }

    .menu-toggle {
      display: none;
    }

    nav {
      li > a {
          font-family: 'Montserrat', sans-serif;
          color: #323232;
      }
    }
  }

  body.article-preview {
    main {
      align-items: center;
      flex-direction: column;
      gap: 60px;
      padding: 0;
      display: flex;
      width: 100%;
    }
    
    .article-preview-header {
      background: #f3f1ed;
      display: flex;
      flex-direction: column;
      padding: 36px var(--pad-x-g) 0;
      width: 100%;
  
      * {
        font-family: 'Montserrat', serif !important;
        color: #888;
      }
  
      .article-title {
        font-size: 32px;
        color: #323232;
        font-weight: 500;
        line-height: 1.2;
        width: 95%;
      }

      #affiliations-list {
        margin-bottom: 16px;
      }
  
      .header-bottom {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: space-between;
        padding: 25px 0;
        width: 100%;

        .button-common {
          color: var(--color-skyblue);
          cursor: pointer;

          &:hover {
            color: #323232;
          }
        }
    
        > div {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          width: fit-content;
        }
      }

      .doi > a {
        color: var(--color-skyblue);
      }
      
      .doi > a:hover {
        color: var(--color-green);
      }
    }
    
    .article-content {
      display: flex;
      overflow-x: clip;
      padding: 0 var(--pad-x-g);
      width: 100%;

      .meta-data {
        border-right: 1px solid var(--color-border-1);
        color: var(--color-skyblue);
        padding: 0;
        max-width: 200px;
        min-width: 160px;
        display: var(--toc-display);
    
        .toc-wrapper {
          top: 120px;
          width: 100%;
        }
    
        .toc {
          padding: 0;
    
          li {
            padding: 4px 20px 4px 0;
            text-transform: capitalize;
    
            &.active {
              border-right: 3px solid var(--color-green);
              font-weight: normal;
              color: var(--color-green);
            }
          }
        }
      }
    }
    
    article {
      display: flex;
      flex-direction: column;
      width: 100%;

      .manuscript {
        display: flex;
        flex-direction: column;
        padding-left: 0;
        padding-right: 0;
        position: relative;
        width: 100%;

        a {
          color: var(--color-skyblue);
        }

        a:hover {
          color: var(--color-green);
        }

        .meta-section {
          border-bottom: 1px solid var(--color-border-1);
          padding: 40px 5% 60px;
          margin-bottom: 0;

          h3.meta-section-title {
            margin: 0;
            color: #323232;
            font-size: 24px;
            padding-bottom: 20px;
            text-transform: uppercase;
          }



          h1,
          h2,
          h3:not(.meta-section-title),
          h4,
          h5 {
            font-family: 'Merriweather', serif;
            color: #323232;
          }

          h3 {
            font-size: 24px;
          }

          h4 {
            font-size: 20px;
          }

          p {
            font-size: 18px;
            font-family: 'Merriweather', serif;
            color: #323232;
          }

          &#meta-abstract {
            padding-top: 0;
          }

          &#meta-paper {
            table {
              border: 1px solid var(--color-border-1);
              border-collapse: collapse;
              border-radius: 12px;
              font-size: 0.7em;
              max-width: 100%;
              width: 100%;
              margin: 2em auto;
    
              p.paragraph {
                margin: 0 !important;
                text-align: center;
              }
    
              td {
                padding: 4px;
              }
            }
          }

          &#meta-declarations {
            li::marker {
              display: none !important;
              content: '' !important;
            }
          }

          &#meta-evaluations {
            .table-wrapper {
              outline: 1px solid #f3f1ed;
              border-radius: 12px;
            }

            .evaluations-table {
              border: none;
              margin: 0;
              overflow: hidden;
              max-width: 100%;
    
              * {
                border-color: #f3f1ed !important;
              }
    
              thead {
                background: var(--color-green);
              }
    
              tr > td {
                border: none;
                font-size: 18px;
                font-family: 'Merriweather', serif;
                color: #323232;
                width: 95px;
              }
    
              th {
                font-size: 16px;
                height: 60px;
                text-transform: uppercase;
                text-align: left;
              }
    
              tbody {
                > :last-child {
                  border-bottom: none;
                }

                tr > :nth-child(2) {
                  color: var(--color-skyblue);
                }
              }
    
              th,
              td {
                padding: 8px 20px;
                max-width: 200px;
                text-align: center;
              }
    
              td {
                height: 80px;
    
                a {
                  display: flex;
                }
    
                a > img {
                  max-width: 100px;
                  padding: 0px;
                  transform: scale(0.8);
                }
              }
            }
          }
        }
      }
    }
  }

  footer {
    * {
      font-family: 'Merriweather', serif;
    }
    
    a {
      color: var(--color-skyblue);
    }

    .footer-container {
      border-top: 1px solid #F3F1ED;
      display: flex;
    }

    .footer-column {
      border-right: 1px solid #F3F1ED;
      flex: 1 1 0;
      padding: 40px;
    }
    
    .footer-column:last-child {
      border-right: none;
    }
  }


/* UTILS */

  .table-wrapper {
    overflow: auto;
  }

  .button-common {
    align-items: center;
    display: flex;
    justify-content: center;
    height: 40px;
    background-color: rgb(255, 255, 255);
    border-radius: 20px;
    border: 2px solid var(--color-skyblue);
    padding: 16px;
    color: var(--color-skyblue);
    font-size: 14px;
    text-decoration: none;
    font-style: normal;
    font-weight: bold;
    text-transform: uppercase;
    width: fit-content;

    a {
      color: var(--color-skyblue);
    }

    &.icon {
      width: 40px;
      border-radius: 50%;
      padding: 0;
    }

    &:hover {
      color: #fff;
      background: var(--color-green);
      border-color: var(--color-green);

      a {
        color: #000 !important;
      }

      svg,
      path {
        fill: #323232 !important;
      }
    }
  }

#download-pdf a {
  color: var(--color-skyblue) !important;
}
  .flex-row {
    align-items: center;
    display: flex;
    gap: 8px;
    justify-content: space-between;
    margin: auto;
    width: fit-content;
  }


@media only screen and (max-width: 768px) {
    body {
        --toc-display: none;
        --header-height: 65px;
        --pad-x-g: 5%;

      &.article-preview .article-preview-header {
        .header-bottom {
          align-items: flex-end;
          flex-direction: column;
        }
      }

      header.topbar a.logo img {
        height: 30px;
      }

      nav#menu {
          background: var(--color-green);
          border-block: 2px solid;
          border-block-color: var(--color-green);
          border-width: 0;
          position: fixed;
          left: 5%;
          top: var(--header-height);
          overflow: hidden;
          transition: all 0.3s;
          max-height: 0;
          padding: 0;
          width: 90%;

          * {
              white-space: nowrap;
          }
      }

      /*menu btn*/
      input#menu-btn {
          display: none;
      }

      .menu-icon {
          cursor: pointer;
          display: flex;
          height: 24px;
          padding: 16px;
          width: 24px;
          transform: scale(1.2);
      }

      label.menu-icon {
          position: relative;
          z-index: 200;
          display: none;
          margin-bottom: 5px;
          @media screen and (max-width: 768px) {
              display: flex;
          }
      }

      .menu-icon .menu, .menu-icon .menu::before, .menu-icon .menu::after {
          background: var(--color-green);
          content: '';
          display: block;
          height: 2px;
          position: absolute;
          transition: background ease 0.2s, top ease 0.2s 0.2s, transform ease 0.2s;
          width: 20px;
      }

      .menu-icon:hover .menu, .menu-icon:hover .menu::before, .menu-icon:hover .menu::after {
          background: var(--color-green);
      }

      .menu-icon .menu {
          left: 6px;
          top: 16px;
      }

      .menu-icon .menu::before {
          top: -6px;
      }

      .menu-icon .menu::after {
          top: 6px;
      }

      #menu-btn:checked + .menu-icon .menu {
          background: transparent;
      }

      #menu-btn:checked + .menu-icon .menu::before {
          transform: rotate(45deg);
      }

      #menu-btn:checked + .menu-icon .menu::after {
          transform: rotate(-45deg);
      }

      #menu-btn:checked + .menu-icon .menu::before, #menu-btn:checked + .menu-icon .menu::after {
          top: 0;
          transition: top ease 0.2s, transform ease 0.2s 0.2s;
      }

      #menu-btn:checked ~ nav {
          background: #fff;
          max-height: 500px;
          border-block-color: var(--color-green);
          padding: 0 35px;
          box-shadow: 0px 10px 10px #0003;
          border-width: 2px;

          * {
                opacity: 1;
          }

          ul > li {
            border-bottom: 1px solid #f3f1ed;
            width: 100%;
          }
      }

      @media only screen and (max-width: 768px) {
        .footer-container {
          flex-direction: column;
          width: 100%;
        }
      
        .footer-column {
          border-right: none;
          border-bottom: 1px solid #F3F1ED;
          padding: 16px 0px;
        }
      
        .footer-column:last-child {
          border-bottom: none;
        }
      }
   }
}

</style>
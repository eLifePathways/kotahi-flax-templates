      </li>
      <li>
          <a href="https://lifecyclejournal.org/publications">Publications</a>
      </li>
      <li>
          <a href="https://lifecyclejournal.org/policies">Policies</a>
      </li>
      <li>
          <a href="https://lifecyclejournal.org/submission-guidelines">Submission Guidelines</a>
      </li>
      <li>
          <a href="https://lifecyclejournal.org/evaluation-services">Evaluation Services</a>
      </li>
      <li>
          <a href="https://osf.io/registries/lifecyclejournal/new">Submit</a>
      </li>
    </ul>
  </nav>
</header>
<header class="topbar">
      {% include "_partials/logo.njk" %}
  <input type="checkbox" id="menu-btn"><label for="menu-btn" class="menu-icon">
    <div class="menu"></div>
  </label>
  <nav id="menu">
    <ul>
      {% for cmsHeaderPage in (cmsLayout.flaxHeaderConfig | reorderPages) %}
        {% if cmsHeaderPage.shownInMenu == true or cmsHeaderPage.shownInMenu == "true" %}
          <li>
            <a
            href="{{ cmsHeaderPage.url }}"
            title="{{ cmsHeaderPage.title }}">
              {{ cmsHeaderPage.title }}
            </a>
          </li>
        {% endif %}

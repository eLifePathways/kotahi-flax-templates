permalink: /assets/css/theme/default.css
---

:root {
    --color-primary: {{ cmsLayout.primaryColor | valueOrDefault('#30ac66') | safe  }};
    --color-secondary: {{ cmsLayout.secondaryColor | valueOrDefault('red') | safe  }};
    --color-background: #fff;
    --color-grey: #999;
    --color-grey-light: #ccc;
    --color-highlight: #e6f2cd; 
    --color-body: #3e3e3e;
    --font-size: 1em;
    --base-font-size: 16;
    --font-meta: "Noto Sans";
    --font-interface: "Noto Sans";
    --font-content: "Noto Sans";

    --color-skyblue: #449dd1;
    --color-border-1: #ddd;
    --color-green: #99c97e;
}

body.article-preview {
    & .article-preview-header {    
        #cite-btn {
          position: relative;
          overflow: visible;
        
          &:focus-within {
            .popover {
              opacity: 1;
              transform: scale(1);
              margin-top: 12px;
            }
          }
        }
        
        .popover {
          background: var(--color-background);
          display: flex;
          border-radius: 1rem;
          box-shadow: 0 0 12px #0002;
          position: absolute;
          height: fit-content;
          opacity: 0;
          padding: 8px 12px;
          text-align: left;
          text-transform: none;
          transform: scale(0);
          transition: all 0.8s;
          right: 0;
          width: 400px;
          margin-top: 12px;
        
          > span {
            display:flex;
            font-family: 'Merriweather', serif !important;
            padding-left: 12px;
            width: calc(100% - 30px);
          }
        
          > svg {
            color: var(--color-skyblue) !important;
            fill: var(--color-skyblue) !important;
          }
        
          &.cite_btn {
            top: 40px;
          }
        }

      #versions-btn {
        position: relative;
        overflow: visible;
      
        &:focus-within {
          .popover {
            opacity: 1;
            transform: scale(1);
            margin-top: 12px;
          }
        }
      }
      
      .popover.versions_btn {
        top: 40px;
        width: auto;
        min-width: 200px;
        flex-direction: column;
        max-height: 300px; /* or whatever fits */
        overflow-y: auto;  /* scroll when needed */
        z-index: 9999;     /* make sure it’s on top */
      }

      
      .version-list {
        list-style: none;
        margin: 0;
        padding: 0;
      
        li {
          margin: 6px 0;
          font-family: 'Merriweather', serif;
          font-size: 16px;
      
          a {
            text-decoration: none;
            font-weight: 400;
            color: var(--color-text); /* base/default text colour */
            transition: color 0.3s ease;
          }
      
          &.current a {
            font-weight: bold;
            color: green;
          }
      
          a:hover {
            color: var(--color-primary); /* or red for testing */
            text-decoration: underline;
          }
        }
      }
    }
}

::-webkit-scrollbar {
    height: 5px;
    width: 5px;
}

::-webkit-scrollbar-thumb {
    background: var(--color-green);
    border-radius: 5px;
    width: 5px;
}

::-webkit-scrollbar-track {
    background: #fff0;
    padding: 5px;
}



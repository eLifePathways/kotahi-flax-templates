                                      {% endif %}
                                  </a>
                              {% endif %}
                          {% endfor %}
                      </div>
                  </div>
              </div>
          {% endfor %}
      </div>
  {% endif %}
{% endmacro %}

{% macro renderDeclarations(declarations) %}
    {% for key, value in declarations %}
        {% if value %}
            <h4>{{ key | capitalize }}</h4>
                {{ value }}
        {% endif %}
    {% endfor %}
{% endmacro %}
{% macro renderSection(key, content) %}
    {% if content %}
        <section id="meta-{{ key }}" class="meta-section">
            <h3 id="{{ key }}" class="meta-section-title">{{ key | capitalize }}</h3>
            {% if key == 'evaluations' %}
                {{ renderEvaluations(content) }}
            {% else %}
                {{ content | safe }}
            {% endif %}
        </section>
    {% endif %}
{% endmacro %}



{% set submission = article.submission %}
{% set contributors = article.articleMetadata.submission.$authors | safe  %}

{% set affilList = [] %}
{% for contributor in article.articleMetadata.submission.$authors %}
  {% for affil in contributor.ror %}
    {% if affil.label not in affilList %}
      {% set affilList = affilList.concat([affil.label]) %}
    {% endif %}
  {% endfor %}
{% endfor %}

{% set evaluations =  article.articleMetadata.submission.evaluations %}
{% set sections = {
    'abstract': submission.$abstract,
    'evaluations': evaluations,
    'registration': submission.registration,
    'materials': submission.materials,
    'data': submission.data,
    'code': submission.code,
    'paper': article.meta.source
}
%}
{% macro renderEvaluations(evaluations) %}
  <!-- Define the image URL mapping -->
  {% set IMG_URL_MAP = {
    'Data-Seer.png': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/Data-Seer.png?resize=980%2C261&ssl=1',
    'onlygoodantibodies': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/OGA-bold-undertext-4-min-3.png?resize=1080%2C502&ssl=1',
    'paperwizard.png': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/paperwizard.png?w=764&ssl=1',
    'PCI.jpg': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/PCI.jpg?w=640&ssl=1',
    'pci-rr.jpg': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/pci-rr.jpg?w=658&ssl=1',
    'prereview.png': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/prereview.png?w=443&ssl=1',
    'RegCheck.png': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/RegCheck.png?resize=1080%2C225&ssl=1',
    'research-hub.png': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/research-hub.png?resize=1080%2C249&ssl=1',
    'statcheck.png': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/statcheck.png?w=548&ssl=1',
    'michelenuijten': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/statcheck.png?w=548&ssl=1',
    'Unjournal.png': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/Unjournal.png?w=773&ssl=1',
    'codecheck_logo.png': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/codecheck_logo.png',
    'SciScore-1.png': 'https://i0.wp.com/lifecyclejournal.org/wp-content/uploads/SciScore-1.png'
  } %}

  {% if evaluations %}
      <div class="evaluations-grid">
          <!-- Header row -->
          <div class="eval-row eval-header">
              <div class="eval-cell">Service</div>
              <div class="eval-cell">Summary</div>
              <div class="eval-cell">Version</div>
              <div class="eval-cell">Date</div>
              <div class="eval-cell">Evaluated</div>
          </div>

          <!-- Data rows -->
          {% for evaluation in evaluations %}
              <div class="eval-row">
                  {% set parts = evaluation.url | split(',') %}

                  <!-- Service -->
                  <div class="eval-cell">
                      {% if parts[1] %}
                          <a href="{{ parts[1] }}" target="_blank">
                              {% if parts[0] in IMG_URL_MAP %}
                                  <img src="{{ IMG_URL_MAP[parts[0]] }}" alt="{{ parts[0] }}" />
                              {% else %}
                                  {{ parts[0] }}
                              {% endif %}
                          </a>
                      {% else %}
                          {{ parts[0] }}
                      {% endif %}
                  </div>

                  <!-- Summary -->
                  <div class="eval-cell">{{ parts[2] if parts[2] else '' }}</div>
                  
                  <!-- Version -->
                  <div class="eval-cell">{{ parts[3] if parts[3] else '' }}</div>
                  
                  <!-- Date -->
                  <div class="eval-cell">{{ parts[4] if parts[4] else '' }}</div>

                  <!-- Evaluated -->
                  <div class="eval-cell">
                      <div class="flex-row">
                          {% for i in range(5, parts | length) %}
                              {% if parts[i] == '1' %}
                                  <a href="#" class="button-common icon">
                                      {% if i - 5 == 0 %}

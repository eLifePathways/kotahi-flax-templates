@page {
  size: letter;
  margin: 30mm 15mm 22mm 18mm;

  @top-right {
    content: element(citation);
    text-align: right;
    color: var(--color-main);
    display: block;
    letter-spacing: 0.05ch;
    font-weight: 500;
    height: 40px;
    font-size: 0.8em;
    align-item: end;
    /* padding-top: 1.4em; */
  }

  @bottom-left {
    color: var(--color-main);
    font-size: 0.8em;
  }

  @bottom-right {
    content: counter(page) '/' counter(pages);
  }

  @bottom-left {
    content: element(licence);
    font-size: 0.8em;
  }
}

@page :first {
  margin-top: 0mm; /* Reduce top margin so header moves up */
  margin-bottom: 25mm; /* Keep footer space balanced */
  /* margin-bottom: 8em;
 */
  @bottom-center {
    content: element(licence);
    font-size: 0.8em;
  }

  @bottom-left {
    content: element(qrcode);
    width: 100px;
    top: 0;
  }

  @bottom-right {
    content: counter(page) '/' counter(pages);
  }

  @top-right {
    content: none;
    border-bottom: 0;
  }

  @top-left {
    content: none;
  }
}


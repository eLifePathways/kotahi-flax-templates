/* CSS for the evaluations grid that mimics a table */
.evaluations-grid {
  outline: 1px solid #f3f1ed;
  border-radius: 12px;
  overflow: hidden;
  width: 100%;
}

.eval-row {
  display: flex;
  width: 100%;
  border-bottom: 1px solid #f3f1ed;
}

.eval-row:last-child {
  border-bottom: none;
}

.eval-header {
  background: var(--color-green);
  border-radius: 12px 12px 0 0;
}

.eval-cell {
  flex: 1;
  padding: 8px 20px;
  text-align: center;
  min-height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-family: 'Merriweather', serif;
  color: #323232;
  word-break: break-word;
}

.eval-header .eval-cell {
  font-size: 14px;
  height: 60px;
  text-transform: uppercase;
  text-align: center;
  font-weight: bold;
  white-space: nowrap;
}

.eval-row:not(.eval-header) .eval-cell:nth-child(2) {
  color: var(--color-skyblue);
}

.eval-cell .button-comon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.eval-cell a > img {
  max-width: 100px;
  padding: 0;
  transform: scale(0.8);
}

.published-date {
  margin-top: 10px;
}

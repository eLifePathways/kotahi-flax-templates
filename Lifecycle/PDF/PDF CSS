}




/* Hides inline footnotes coming from wax */
footnote {
  white-space: nowrap;
  overflow: hidden;
  text-indent: -9999px;
  display: inline-block;
  width: 0;
  height: 0;
}

/* Highlight rows 4 and 9 for table 1 and 2 */
table:nth-of-type(1) tr:nth-child(5),
table:nth-of-type(1) tr:nth-child(10) {
  background-color: #f3f1ed;
}

table:nth-of-type(2) tr:nth-child(9),
table:nth-of-type(2) tr:nth-child(19) {
  background-color: #f3f1ed;
}



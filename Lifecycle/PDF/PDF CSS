.article {
  counter-reset: figure;
}

.article figure {
  break-inside: avoid;
  counter-increment: figure;
  margin: 0 auto auto;
}

.article figure img {
  object-fit: contain;
  border: 1px solid var(--color-main-light-text);
  width: 100%;
  margin: auto;
  padding: 1em 5ch;
}

.article figure figcaption {
  max-width: 80ch;
  margin: 0 auto 0.8em;
  font-size: 0.8em;
}

.article figure figcaption:before {
  content: 'Fig.\00A0'counter(figure);
  color: var(--color-main-light-text);
  margin-right: 1ch;
  font-weight: 600;
}

table {
  border-collapse: collapse;
  border: 1px solid var(--color-main-light-text);
  width: 100%;
  font-size: 0.9em;

  table-layout: fixed;
  overflow-wrap: break-word;
  word-break: break-word;
  page-break-inside: auto;
}

.table-wrapper {
  width: 100%;
  overflow-x: auto;

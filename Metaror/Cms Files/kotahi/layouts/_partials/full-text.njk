            <div class="meta-data">
                <aside class="toc-wrapper">
                    {% if article.parsedSubmission.$abstract != 'undefined'  %}
                      <ul>
                        <li>
                            <a href="#abstract" onclick="highlightLink(this)">Abstract</a>
                        </li>
                      </ul>
                    {% endif %}
                    {{ article.meta.source | addIDtoTitles | toc({"tags":["h2","h3", "figure"]}) | safe }}
                    <ul>
                  
                    {% if article.supplementaryFiles and article.supplementaryFiles | length >= 1 %}
                        <li>
                            <a href="#supplementary" onclick="highlightLink(this)">Supplementary Files</a>
                        </li>
                    {% endif %}
                     
                    {% if article.decisions and article.decisions | length > 0 %}
  {% set authorResponse = article.decisions[0].jsonData | findElement('field.component', 'ThreadedDiscussion') %}
{% else %}
  {% set authorResponse = null %}
{% endif %}

                    
                    {%  if authorResponse != null %}
                         <li>
                            <a href="#authorResponse" onclick="highlightLink(this)">Author Response</a>
                        </li>
                    {% endif %}

                     </ul>
                </aside>
            </div>
            <article>
                <section class="manuscript">
                    {% if article.parsedSubmission.$abstract != 'undefined'  %}
                        <h3 id="abstract">Abstract</h3>
                        <section class="abstract">
                            {{ article.parsedSubmission.$abstract | safe }}
                        </section>
                    {% endif %}
                    {% if article.meta.source %}
                            {% set handledContent = article.meta.source | addIDtoTitles | imagesHandler(article.shortId, 'articles', cmsConfig.group, cmsLayout.hexCode) %}
                        <section id="article" class="article">
                         <!--<span>.</span>-->
                          {% if article.parsedSubmission.hideFigLabels == 'yes' %}
                             {% set modifiedContent = handledContent | safe | replace("<figure>", "<figure class='hideLabel'>") %}
                             {{ modifiedContent }}
                          {% else %}
                            {{ handledContent | safe }}
                          {% endif %}
                          
                        </section>
                        <script>
                            console.log("Handled Content:", {{ handledContent | dump | safe }})

    const sectionarticleShortId = `{{ article.shortId | safe }}`
    console.log('section articleShortId', sectionarticleShortId)

    const sectiongroupr = `{{ cmsConfig.group.name | safe }}`
    console.log('section groupr', sectiongroupr)

    const sectioncmsHexCode = `{{ cmsLayout.hexCode | safe }}`
    console.log('section cmsHexCode', sectioncmsHexCode)
    console.log('section typeof cmsHexCode', typeof sectioncmsHexCode)
                        </script>
                    {% endif %}
                    {% if article.supplementaryFiles and article.supplementaryFiles | length >= 1 %}
                        <section class="manuscript-metadata">
                            <h3 id="supplementary">Supplementary Files</h3>

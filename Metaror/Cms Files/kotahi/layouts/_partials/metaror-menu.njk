<script>
  document.addEventListener('DOMContentLoaded', () => {
    const select = s => document.querySelector(s)
    const all = s => [...document.querySelectorAll(s)]
    const mainContainer = select('main') || select('#main-container')
    const dropdownControls = all('input.dropdown-btn')
    const menu_btn = select('#menu-btn')
    const topbar = select('#topbar')

    menu_btn.addEventListener('input', e => {
      const { checked } = e.target
      const method = checked ? 'add' : 'remove'
      topbar.classList[method]('hide-topbar')
      const transition = checked ? 'all 0.3s 0s' : 'all 0.3s 0.3s'
      topbar.style.transition = transition
    })
    const closeDropdown = checkbox => (checkbox.checked = false)
    const closeAll = () => dropdownControls.forEach(closeDropdown)

    const closeOthers = checkbox => {
      const others = dropdownControls.filter(curr => curr !== checkbox)
      others.forEach(closeDropdown)
    }

    mainContainer.addEventListener('click', closeAll)
    dropdownControls.forEach(checkbox => {
      checkbox.addEventListener('input', () => closeOthers(checkbox))
    })
  })
</script>

{% extends '../layouts/base.njk' %}
{% set currentPage = article %}
{% set title = article.meta.title %}
{% block content %}

{% set rorArray = [] %}
{#
 {% for authorRor in article.headerInfo.authorNames %}
   {% if authorRor.ror | length %}
      {% for rorItem in authorRor.ror %}
         {% if not (rorItem.label in rorArray) %}
            {% set rorArray = rorArray.concat([rorItem.label]) %}
         {% endif %}
      {% endfor %}
   {% else %}
      {% if not (authorRor.ror.label in rorArray) %}
         {% set rorArray = rorArray.concat([authorRor.ror.label]) %}
      {% endif %}
   {% endif %}
{% endfor %}
#}

<div id="main-container">
 <main>
        <div class="article-preview-header">
            <span class="topics">
                {{ article.headerInfo.topics }}
            </span>
            <span class="article-title">
                {{ article.headerInfo.title }}</span>
            <ul class="authors metadata">
                {% for author in article.headerInfo.authorNames %}
                    <li class="author metadata">
                        <span class="author-name">
                          {{- author.firstName -}}{% if author.middleName %}&nbsp;{{- author.middleName -}}{% endif %}&nbsp;{{- author.lastName -}}
                          {% for r in rorArray %}
                            {% if author.ror.label == r  %}
                              <sup>{{ loop.index }}&nbsp;</sup>
                            {% endif %}
                         {% endfor %}
                        </span>
                        {% if author.email %}
                            <a class="email" href="mailto:{{ author.email }}"></a>
                        {% endif %}
                        {% if author.orcid %}
                            <a class="orcid" target="_blank" href="https://orcid.org/{{ author.orcid }}"></a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>

            {% if article.headerInfo.authorNames %}
              <ol id="affiliations-list">
                {% for re in rorArray %}
                <li style="margin-left: 0px;">
                    {{ re | safe }}
                </li>
                {% endfor %} 
              </ol>  
            {% endif %}
            
            <span class="header-doi-and-licenses">
              {% if article.parsedSubmission.displayLink == 'url' %}
                <div class="link">Originally published <a href="{{ article.parsedSubmission.preprinturl }}">here</div></a>
              {% else %}
                <div class="link">Originally published <a href="https://doi.org/{{ article.headerInfo.DOI }}">here</div></a>
              {% endif %}
                {% if cmsLayout.publishConfig.licenseUrl %}
                    <div class="link"><a href="{{cmsLayout.publishConfig.licenseUrl}}">
                        {{cmsLayout.publishConfig.licenseUrl}}
                    </a></div>
                {% endif %}
            </span>

            {% if article.headerInfo.publishedOn %}
                <p class="published-date">
                    Published on <time datetime="article.headerInfo.publishedOn">{{ article.headerInfo.publishedOn | replace('Z','') | postDate }}</time>
                </p>
            {% endif %}
        </div>

        {% include "_partials/tabs.njk" %}

    </main>

  {% include "_partials/side.njk" %}

</div>     
{% endblock %}